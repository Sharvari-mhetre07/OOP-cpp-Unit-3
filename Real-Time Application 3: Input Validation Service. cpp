#include <iostream>
#include <string>
#include <cctype>
using namespace std;

class Validator {
public:

    bool validate(int marks) const {
        return marks >= 0 && marks <= 100;
    }

    bool validate(double amount) const {
        return amount > 0.0 && amount <= 1000000.0;
    }

    bool validate(const string& name) const {

        if (name.empty())
            return false;

        for (char ch : name) {

            if (!isalpha(ch) && ch != ' ')
                return false;
        }

        return true;
    }
};

int main() {

    Validator validator;

    cout << boolalpha;

    cout << "Marks 85 valid: "
         << validator.validate(85) << endl;

    cout << "Marks 105 valid: "
         << validator.validate(105) << endl;

    cout << "Amount 5000 valid: "
         << validator.validate(5000.0) << endl;

    cout << "Name Sharvari Mhetre valid: "
         << validator.validate(
                string("Sharvari Mhetre"))
         << endl;

    cout << "Name Sharvari123 valid: "
         << validator.validate(
                string("Sharvari123"))
         << endl;

    return 0;
}
